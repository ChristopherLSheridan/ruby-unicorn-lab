[Unit]
Description=Ruby Unicorn SRE Lab
After=network.target

[Service]
Type=simple
User=christopher
Group=www-data
WorkingDirectory=/home/christopher/projects/ruby-unicorn-lab
RuntimeDirectory=unicorn-lab
RuntimeDirectoryMode=0755
UMask=0007
ExecStart=/usr/bin/bash -lc 'exec /usr/bin/bundle exec unicorn -c config/unicorn.rb app/config.ru'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
